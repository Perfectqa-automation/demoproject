
{
  "config": {
    "browser": "chrome",
    "headless": false
  },
  "logIn": {
    "url": "https://www.saucedemo.com/",
    "username": "//input[@id='user-name']",
    "password": "//input[@id='password']",
    "loginButton": "//input[@id='login-button']"
  },
  "homePage": {
    "product": "//div[@data-test='inventory-item-name']"
  },
  "productPage": {
