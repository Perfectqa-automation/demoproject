  },
  "informationPage": {
    "firstName": "//input[@id='first-name']",
    "lastName": "//input[@id='last-name']",
    "zipCode": "//input[@id='postal-code']",
    "continueButton": "//input[@id='continue']"
  },
  "overview": {
    "finishButton": "//button[@id='finish']"
  }
